---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourCard from "../../components/TourCard.astro";
import siteData from "../../data/sites/lankawayfinder.json";
import { nonDefaultLanguages, type SupportedLanguage, getLocalizedUrl } from "../../i18n/languages";
import { toursPageContent } from "../../i18n/content";
import { useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return nonDefaultLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const content = toursPageContent[lang] || toursPageContent.en;

const { tours } = siteData;
const sortedTours = [...tours].sort((a, b) => b.ratingScore - a.ratingScore);

const categories = [
  { name: t("btn.filter_all"), filter: "all" },
  { name: t("btn.filter_safari"), filter: "safari" },
  { name: t("btn.filter_culture"), filter: "culture" },
  { name: t("btn.filter_rail"), filter: "rail" },
  { name: t("btn.filter_ocean"), filter: "ocean" },
  { name: t("btn.filter_food"), filter: "food" },
];
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDesc}
  currentPath={`/${lang}/tours/`}
  lang={lang}
>
  <!-- Page Hero -->
  <section class="section section--cream" style="padding-top:clamp(4rem, 6vw, 5.5rem);padding-bottom:clamp(3rem, 5vw, 4.5rem);">
    <div class="container">
      <div class="section-header section-header--left" style="max-width:820px;margin-bottom:0;">
        <span class="section-pill">{t("badge.verified")}</span>
        <h1 style="margin-bottom:1rem;">{content.heroTitle}</h1>
        <p class="section-subtitle">
          {content.heroSubtitle}
        </p>

        <!-- JSON-LD BreadcrumbList & ItemList Schema -->
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "BreadcrumbList",
              "itemListElement": [
                {
                  "@type": "ListItem",
                  "position": 1,
                  "name": t("nav.home"),
                  "item": `https://lankawayfinder.tours${getLocalizedUrl(lang, "/")}`
                },
                {
                  "@type": "ListItem",
                  "position": 2,
                  "name": t("nav.tours"),
                  "item": `https://lankawayfinder.tours/${lang}/tours/`
                }
              ]
            },
            {
              "@type": "ItemList",
              "name": content.heroTitle,
              "description": content.metaDesc,
              "numberOfItems": sortedTours.length,
              "itemListElement": sortedTours.map((tour, idx) => ({
                "@type": "ListItem",
                "position": idx + 1,
                "url": `https://lankawayfinder.tours/${lang}/tours/#${tour.id}`,
                "name": tour.title
              }))
            }
          ]
        })} />
      </div>
    </div>
  </section>

  <!-- Filter Pills Bar & Tour Grid -->
  <section class="section" id="tours">
    <div class="container">
      <!-- Category Filter Tabs -->
      <div style="display:flex;flex-wrap:wrap;gap:0.6rem;margin-bottom:2.5rem;align-items:center;" id="filter-container" data-ui>
        {categories.map((c, i) => (
          <button
            type="button"
            id={c.filter}
            class={`btn btn--sm ${i === 0 ? "btn--amber" : "btn--ghost"}`}
            data-filter={c.filter}
            style="font-size:0.875rem;"
          >
            {c.name}
          </button>
        ))}
      </div>

      <!-- Tours Responsive Grid -->
      <div class="grid-3" id="tours-grid" data-ui>
        {sortedTours.map((tour) => {
          let catClass = "safari";
          if (tour.category.toLowerCase().includes("culture") || tour.category.toLowerCase().includes("heritage")) catClass = "culture";
          else if (tour.category.toLowerCase().includes("rail") || tour.category.toLowerCase().includes("hiking")) catClass = "rail";
          else if (tour.category.toLowerCase().includes("ocean") || tour.category.toLowerCase().includes("marine")) catClass = "ocean";
          else if (tour.category.toLowerCase().includes("culinary") || tour.category.toLowerCase().includes("food")) catClass = "food";

          return (
            <div class="tour-item-wrapper" data-cat={catClass}>
              <TourCard tour={tour} lang={lang} />
            </div>
          );
        })}
      </div>

      <!-- Complete 2026 Tours & Safaris Comparison Table for AI & Quick Scanning -->
      <details style="margin-top:2.5rem;background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);padding:1.25rem 1.5rem;">
        <summary style="font-weight:700;font-size:1.05rem;color:var(--ink-primary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;">
          <span>{content.heroTitle} Side-by-Side Comparison Ledger ({sortedTours.length} Experiences)</span>
          <span style="color:var(--accent-amber);font-size:0.875rem;font-weight:600;">View Full Table ▾</span>
        </summary>
        <div tabindex="0" role="region" aria-labelledby="tours-ledger-caption" class="pricing-table-container" style="margin-top:1.25rem;overflow-x:auto;">
          <table class="pricing-table">
            <caption id="tours-ledger-caption" class="sr-only">Side-by-side comparison of 10 verified Sri Lanka tours, safaris, ratings, durations, and starting prices</caption>
            <thead>
              <tr>
                <th scope="col">Experience / Tour Title</th>
                <th scope="col">Corridor</th>
                <th scope="col">Duration</th>
                <th scope="col">Rating</th>
                <th scope="col">Starting Price</th>
                <th scope="col">Chauffeur / Permit Note</th>
              </tr>
            </thead>
            <tbody>
              {sortedTours.map((tour) => (
                <tr>
                  <th scope="row" style="font-weight:700;color:var(--ink-primary);text-align:left;">
                    <a href={`#${tour.id}`} style="color:var(--ink-primary);text-decoration:underline;">{tour.title}</a>
                  </th>
                  <td>{tour.region}</td>
                  <td>{tour.durationShort || tour.duration.replace("DURATION: ", "")}</td>
                  <td style="white-space:nowrap;"><strong>{tour.ratingScore.toFixed(2)}/5</strong> ({tour.reviewCount.toLocaleString()})</td>
                  <td style="font-weight:700;color:#B26A06;white-space:nowrap;">{tour.price.replace("FROM ", "")}</td>
                  <td style="font-size:0.875rem;color:var(--ink-muted);">{tour.chauffeurNote}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>

  <!-- Booking Trust Bar -->
  <section class="section section--cream">
    <div class="container">
      <div class="grid-3" style="text-align:center;" data-ui>
        <div class="trust-feature-card" style="background:#FFFFFF;border-radius:var(--radius-lg);padding:2rem;border:1px solid var(--border-subtle);">
          <div style="margin-bottom:0.75rem;color:var(--accent-amber);display:flex;justify-content:center;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h3 style="font-size:1.2rem;margin-bottom:0.5rem;">{t("badge.free_cancel")}</h3>
          <p style="font-size:0.9375rem;color:var(--ink-muted);line-height:1.5;margin:0;">
            Plans change. Cancel up to 24 hours in advance on most experiences for a full, hassle-free refund.
          </p>
        </div>

        <div class="trust-feature-card" style="background:#FFFFFF;border-radius:var(--radius-lg);padding:2rem;border:1px solid var(--border-subtle);">
          <div style="margin-bottom:0.75rem;color:var(--accent-amber);display:flex;justify-content:center;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <h3 style="font-size:1.2rem;margin-bottom:0.5rem;">{t("badge.instant_confirm")}</h3>
          <p style="font-size:0.9375rem;color:var(--ink-muted);line-height:1.5;margin:0;">
            Secure your date immediately without waiting for emails. Mobile barcoded tickets sent straight to your phone.
          </p>
        </div>

        <div class="trust-feature-card" style="background:#FFFFFF;border-radius:var(--radius-lg);padding:2rem;border:1px solid var(--border-subtle);">
          <div style="margin-bottom:0.75rem;color:var(--accent-amber);display:flex;justify-content:center;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          </div>
          <h3 style="font-size:1.2rem;margin-bottom:0.5rem;">Chauffeur Synchronization</h3>
          <p style="font-size:0.9375rem;color:var(--ink-muted);line-height:1.5;margin:0;">
            Smoothly pair any tour with private road transfers. Your luggage stays locked safely in the car during safaris.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll("#filter-container button");
  const tourItems = document.querySelectorAll("#tours-grid .tour-item-wrapper");

  function applyFilter(rawFilter: string) {
    let filter = rawFilter.toLowerCase().replace("#", "");
    if (filter === "wildlife") filter = "safari";
    if (filter === "heritage") filter = "culture";
    if (filter === "highlands") filter = "rail";
    if (filter === "marine") filter = "ocean";
    if (filter === "culinary") filter = "food";

    let matchedBtn: Element | null = null;
    filterBtns.forEach((b) => {
      const bFilter = b.getAttribute("data-filter");
      if (bFilter === filter) matchedBtn = b;
      b.classList.remove("btn--amber");
      b.classList.add("btn--ghost");
    });

    if (matchedBtn) {
      matchedBtn.classList.remove("btn--ghost");
      matchedBtn.classList.add("btn--amber");
    } else {
      filterBtns[0]?.classList.remove("btn--ghost");
      filterBtns[0]?.classList.add("btn--amber");
      filter = "all";
    }

    tourItems.forEach((item) => {
      const cat = item.getAttribute("data-cat");
      if (filter === "all" || cat === filter) {
        item.removeAttribute("hidden");
      } else {
        item.setAttribute("hidden", "until-found");
      }
    });
  }

  const toursGrid = document.getElementById("tours-grid");
  toursGrid?.addEventListener("beforematch", () => {
    applyFilter("all");
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter") || "all";
      applyFilter(filter);
    });
  });

  if (window.location.hash) {
    applyFilter(window.location.hash);
  }
  window.addEventListener("hashchange", () => {
    if (window.location.hash) {
      applyFilter(window.location.hash);
    }
  });
</script>
