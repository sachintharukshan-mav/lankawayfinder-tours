---
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteData from "../../data/sites/lankawayfinder.json";
import { nonDefaultLanguages, languages, type SupportedLanguage, getLocalizedUrl } from "../../i18n/languages";
import { useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return nonDefaultLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langMeta = languages[lang] || languages.en;
const { site, regions } = siteData;

const titles: Record<SupportedLanguage, { title: string; desc: string }> = {
  en: {
    title: "Contact Dispatch Desk | LankaWayfinder.tours",
    desc: "Get in touch with the LankaWayfinder route desk: corrections, gate opening inquiries, chauffeur network bookings, and partnership inquiries."
  },
  de: {
    title: "Kontakt & Kundenservice | LankaWayfinder.tours",
    desc: "Kontaktieren Sie unseren Kundenservice: Routen-Updates, Nationalpark-Öffnungszeiten und Chauffeur-Buchungen in Sri Lanka."
  },
  fr: {
    title: "Contact & Assistance | LankaWayfinder.tours",
    desc: "Contactez notre équipe de coordination au Sri Lanka : questions d'itinéraires, horaires des parcs et réservation de chauffeurs privés."
  },
  ru: {
    title: "Контакты и служба поддержки | LankaWayfinder.tours",
    desc: "Свяжитесь со службой координации маршрутов: вопросы по сафари-паркам, поездам и бронированию персональных водителей."
  },
  it: {
    title: "Contatti e Assistenza Itinerari | LankaWayfinder.tours",
    desc: "Contatta il nostro team di supporto: consigli di viaggio, orari di apertura dei parchi naturali e prenotazione autisti privati."
  },
  es: {
    title: "Contacto y Asistencia de Viaje | LankaWayfinder.tours",
    desc: "Contacta con nuestro equipo de asistencia: resolución de dudas sobre rutas, horarios de parques y reservas de chóferes en Sri Lanka."
  }
};

const meta = titles[lang] || titles.en;
---

<BaseLayout
  title={meta.title}
  description={meta.desc}
  currentPath={`/${lang}/contact/`}
  lang={lang}
>
  <section class="section" style="padding-top:clamp(3.5rem, 6vw, 5rem);padding-bottom:clamp(2.5rem, 4vw, 3.5rem);">
    <div class="container" style="max-width:960px;">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" style="font-size:0.875rem;color:var(--ink-muted);margin-bottom:1.25rem;display:flex;align-items:center;gap:0.5rem;" data-ui>
        <a href={getLocalizedUrl(lang, "/")} style="color:var(--accent-amber);">{t("nav.home")}</a>
        <span>/</span>
        <span style="color:var(--ink-primary);font-weight:600;">{t("nav.contact")}</span>
      </nav>

      <h1 class="animate-enter" style="margin-bottom:1rem;">{meta.title.split("|")[0].trim()}</h1>
      <p class="lead animate-enter" style="max-width:58ch;margin-bottom:2.5rem;">
        {meta.desc}
      </p>

      <!-- JSON-LD BreadcrumbList & ContactPage Schema -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": t("nav.home"),
                "item": `https://lankawayfinder.tours${getLocalizedUrl(lang, "/")}`
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": t("nav.contact"),
                "item": `https://lankawayfinder.tours/${lang}/contact/`
              }
            ]
          },
          {
            "@type": "ContactPage",
            "name": meta.title,
            "description": meta.desc,
            "url": `https://lankawayfinder.tours/${lang}/contact/`
          }
        ]
      })} />

      <div class="animate-shutter" style="border-radius:var(--radius-lg);overflow:hidden;background-color:var(--bg-surface);aspect-ratio:21/9;">
        <img
          src="https://images.unsplash.com/photo-1566296314736-6eaac1ca0cb9?auto=format&fit=crop&w=1600&q=85"
          alt="Mainline passenger train crossing Demodara Nine Arch Bridge in Ella"
          fetchpriority="high"
          width="1200"
          height="514"
          style="width:100%;height:100%;object-fit:cover;"
        />
      </div>
    </div>
  </section>

  <!-- Communication Channels -->
  <section class="section--surface" style="padding-top:clamp(3rem, 5vw, 4.5rem);padding-bottom:clamp(4rem, 6vw, 6rem);">
    <div class="container" style="max-width:960px;">
      <div class="channels-grid animate-enter" data-ui>
        <!-- Channel 1: Phone -->
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <h3>Official Phone Support</h3>
          <p>
            24/7 direct telephone lines for urgent tour assistance, meeting spot directions, and immediate booking queries.
          </p>
          <div style="margin-top:auto;display:flex;flex-direction:column;gap:0.4rem;" data-ui>
            <a href="tel:+18559571272" class="btn btn--sm btn--primary">
              <span>US/CA: +1 855 957 1272</span>
              <span>↗</span>
            </a>
            <a href="tel:+493056839445" class="btn btn--sm btn--secondary">
              <span>Intl: +49 30 56839445</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Channel 2: WhatsApp -->
        <div class="channel-card channel-card--highlight">
          <div class="channel-icon" style="color:var(--accent-gold);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <h3>Official WhatsApp Desk</h3>
          <p>
            Instant text messaging with GetYourGuide's customer service for mobile voucher support and departure updates.
          </p>
          <div style="margin-top:auto;" data-ui>
            <a href="https://wa.me/4915123457858" target="_blank" rel="noopener noreferrer" class="btn btn--sm btn--primary">
              <span>WhatsApp +49 151 23457858</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Channel 3: Help Centre -->
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <h3>24/7 Help Centre &amp; Chat</h3>
          <p>
            Self-service 24-hour free cancellation, instant date changes, and live agent chat directly on GetYourGuide.
          </p>
          <div style="margin-top:auto;" data-ui>
            <a href={`https://www.getyourguide.com/contact/?partner_id=${site.partnerId}&utm_medium=online_publisher&cmp=${site.campaignPrefix}_contact_help&locale=${langMeta.gygLocale}`} target="_blank" rel="noopener noreferrer" class="btn btn--sm btn--secondary">
              <span>GetYourGuide Help Centre</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Corridor Links -->
      <div style="margin-top:3rem;background:#FFFFFF;border-radius:var(--radius-lg);padding:2rem;border:1px solid var(--border-subtle);">
        <h2 style="font-size:1.35rem;margin-bottom:0.75rem;">Explore Regional Travel Corridors</h2>
        <p style="color:var(--ink-muted);font-size:0.9375rem;margin-bottom:1.5rem;">
          Detailed itineraries, drive times, and verified safari contacts for each region:
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
          {regions.map((reg) => (
            <a href={getLocalizedUrl(lang, `/${reg.slug}/`)} class="btn btn--sm btn--secondary">
              <span>{reg.name}</span>
              <span>→</span>
            </a>
          ))}
          <a href={getLocalizedUrl(lang, "/getting-around/")} class="btn btn--sm btn--primary">
            <span>{t("nav.transport")}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
