---
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteData from "../../data/sites/lankawayfinder.json";
import { nonDefaultLanguages, type SupportedLanguage, getLocalizedUrl } from "../../i18n/languages";
import { destinationsContent } from "../../i18n/content";
import { useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return nonDefaultLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const content = destinationsContent[lang] || destinationsContent.en;
const { regions } = siteData;
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDesc}
  currentPath={`/${lang}/destinations/`}
  lang={lang}
>
  <section class="section section--cream" style="padding-top:clamp(4rem, 6vw, 5.5rem);padding-bottom:clamp(3rem, 5vw, 4.5rem);">
    <div class="container">
      <div class="section-header section-header--left" style="max-width:820px;margin-bottom:0;">
        <span class="section-pill">{t("footer.regions")}</span>
        <h1 style="margin-bottom:1rem;">{content.heroTitle}</h1>
        <p class="section-subtitle">
          {content.heroSubtitle}
        </p>

        <!-- Schema.org Breadcrumbs & ItemList -->
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "BreadcrumbList",
              "itemListElement": [
                {
                  "@type": "ListItem",
                  "position": 1,
                  "name": t("nav.home"),
                  "item": `https://lankawayfinder.tours${getLocalizedUrl(lang, "/")}`
                },
                {
                  "@type": "ListItem",
                  "position": 2,
                  "name": t("nav.destinations"),
                  "item": `https://lankawayfinder.tours/${lang}/destinations/`
                }
              ]
            },
            {
              "@type": "ItemList",
              "name": content.heroTitle,
              "description": content.metaDesc,
              "numberOfItems": regions.length,
              "itemListElement": regions.map((r, idx) => ({
                "@type": "ListItem",
                "position": idx + 1,
                "url": `https://lankawayfinder.tours/${lang}/${r.slug}/`,
                "name": r.name
              }))
            }
          ]
        })} />
      </div>
    </div>
  </section>

  <!-- Regional Corridors Grid -->
  <section class="section">
    <div class="container">
      <div class="grid-3" data-ui>
        {regions.map((region) => (
          <a href={getLocalizedUrl(lang, `/${region.slug}/`)} class="corridor-card" aria-label={region.name}>
            <img src={region.image} alt={region.name} class="corridor-card__bg" loading="lazy" />
            <div class="corridor-card__overlay"></div>
            <div class="corridor-card__content">
              <h3 class="corridor-card__title">{region.name}</h3>
              <p class="corridor-card__tagline">{region.tagline}</p>
              <span class="corridor-card__cta">
                <span>View Route Guide</span>
                <span>→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
