---
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteData from "../../data/sites/lankawayfinder.json";
import { nonDefaultLanguages, languages, type SupportedLanguage, getLocalizedUrl } from "../../i18n/languages";
import { useTranslations } from "../../i18n/ui";

export function getStaticPaths() {
  return nonDefaultLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const langMeta = languages[lang] || languages.en;
const { site, routePricing } = siteData;

const titles: Record<SupportedLanguage, { title: string; desc: string }> = {
  en: {
    title: "Getting Around Sri Lanka (2026): Chauffeur Fares, Tolls & Airport Transfers",
    desc: "2026 Sri Lanka private driver rates ($50–$65/day), fixed CMB airport transfer prices ($62 to Galle, $78 to Sigiriya), and safari gate luggage custody."
  },
  de: {
    title: "Unterwegs in Sri Lanka (2026): Chauffeur-Preise, Maut & Transfers | LankaWayfinder",
    desc: "Fahrpreise für private Chauffeure 2026 (50–65 $/Tag), feste Flughafen-Transfers ab Colombo (CMB) und sichere Gepäckverwahrung am Safari-Gate."
  },
  fr: {
    title: "Se Déplacer au Sri Lanka (2026) : Tarifs Chauffeurs, Péages & Aéroport | LankaWayfinder",
    desc: "Tarifs des chauffeurs privés au Sri Lanka (50–65 $/jour), prix fixes depuis l'aéroport de Colombo et consigne bagages sécurisée aux parcs nationaux."
  },
  ru: {
    title: "Транспорт на Шри-Ланке (2026): Цены на водителей, платные трассы и такси | LankaWayfinder",
    desc: "Тарифы персональных водителей (50–65 $/день), фиксированные трансферы из аэропорта Коломбо (CMB) и сохранность багажа во время сафари."
  },
  it: {
    title: "Come Muoversi in Sri Lanka (2026): Tariffe Autisti, Pedaggi & Transfer | LankaWayfinder",
    desc: "Tariffe trasparenti per autisti privati (50–65 $/giorno), transfer fissi dall'aeroporto di Colombo e custodia bagagli sicura durante i safari."
  },
  es: {
    title: "Cómo Moverse por Sri Lanka (2026): Precios de Chófer, Peajes y Aeropuerto | LankaWayfinder",
    desc: "Tarifas de chófer privado en Sri Lanka (50–65 $/día), traslados fijos desde el aeropuerto de Colombo y custodia de equipaje en los safaris."
  }
};

const meta = titles[lang] || titles.en;

const protocols = [
  {
    step: "I",
    title: "Air-Conditioned Highway Dispatch",
    desc: "Your private chauffeur meets you at CMB Bandaranaike International Airport Arrivals Canopy or your city hotel lobby in a clean, insured vehicle with cold bottled water and luggage assistance."
  },
  {
    step: "II",
    title: "Secure Gate Luggage Custody",
    desc: "When transferring between destinations (such as Ella to Mirissa via Udawalawe Safari, or Kandy to Ella by scenic train), your heavy baggage remains safely locked in the vehicle while you enjoy the excursion."
  },
  {
    step: "III",
    title: "Direct Doorstep Handover",
    desc: "At the end of your safari or train ride, your driver meets you promptly at the gate exit or train station platform, transporting you directly to your next boutique hotel or beach villa."
  }
];

const fleets = [
  {
    type: "Premium Sedan (Toyota Axio / Prius)",
    capacity: "Up to 3 Passengers • 2 Large Suitcases",
    idealFor: "Couples & solo travelers connecting between airports and coastal resorts.",
    features: ["Dual air-conditioning", "Full expressway toll coverage", "USB mobile charging ports"]
  },
  {
    type: "High-Roof Van (Toyota KDH Commuter)",
    capacity: "Up to 7 Passengers • 8 Large Bags",
    idealFor: "Families and small groups with surfboards, child seats, and extensive safari camera equipment.",
    features: ["Elevated panoramic windows", "Separate rear luggage hold", "Reclining captain chairs"]
  },
  {
    type: "Compact SUV (Toyota Vezel / Raize)",
    capacity: "Up to 3 Passengers • 3 Medium Bags",
    idealFor: "Scenic hill country mountain passes and tea plantation estate switchbacks.",
    features: ["High road clearance", "Smooth suspension", "Quiet hybrid engine"]
  }
];
---

<BaseLayout
  title={meta.title}
  description={meta.desc}
  currentPath={`/${lang}/getting-around/`}
  lang={lang}
>
  <!-- Page Hero -->
  <section class="section section--cream" style="padding-top:clamp(4rem, 6vw, 5.5rem);padding-bottom:clamp(3rem, 5vw, 4.5rem);">
    <div class="container">
      <div class="section-header section-header--left" style="max-width:820px;margin-bottom:0;">
        <span class="section-pill">{t("nav.transport")}</span>
        <h1 style="margin-bottom:1rem;">{meta.title.split(":")[0]}</h1>
        <p class="section-subtitle">
          {meta.desc}
        </p>
      </div>
    </div>
  </section>

  <!-- 3-Step Handover Protocol -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-pill">Route Coordination</span>
        <h2 class="section-title">The Three-Step Transfer Protocol</h2>
        <p class="section-subtitle">
          How our private chauffeur network solves luggage security during safaris and train rides.
        </p>
      </div>

      <div class="grid-3" data-ui>
        {protocols.map((p) => (
          <div style="background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);padding:2rem;display:flex;flex-direction:column;">
            <div style="font-family:var(--font-serif);font-size:2rem;font-weight:700;color:var(--accent-amber);line-height:1;margin-bottom:1rem;">
              {p.step}
            </div>
            <h3 style="font-size:1.25rem;font-weight:600;margin-bottom:0.75rem;">
              {p.title}
            </h3>
            <p style="font-size:0.9375rem;color:var(--ink-body);line-height:1.6;margin:0;">
              {p.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Route Pricing Ledger -->
  <section class="section section--cream" id="pricing">
    <div class="container">
      <div class="section-header">
        <span class="section-pill">Transparent Pricing</span>
        <h2 class="section-title">Standard Route Pricing Ledger</h2>
        <p class="section-subtitle">
          All prices are flat estimates in USD, including expressway tolls, parking fees, and vehicle fuel.
        </p>
      </div>

      <div tabindex="0" role="region" aria-labelledby="highway-ledger-caption" class="pricing-table-container" style="max-width:960px;margin:0 auto 2.5rem auto;" data-ui>
        <table class="pricing-table">
          <caption id="highway-ledger-caption" class="sr-only">2026 Sri Lanka fixed private chauffeur highway transfer rates in USD</caption>
          <thead>
            <tr>
              <th>Departure Point</th>
              <th>Destination</th>
              <th>Typical Drive Time</th>
              <th>Primary Highway Corridor</th>
              <th>Flat Vehicle Rate</th>
            </tr>
          </thead>
          <tbody>
            {routePricing.map((r) => (
              <tr>
                <td style="font-weight:600;color:var(--ink-primary);">{r.from}</td>
                <td style="font-weight:600;color:var(--ink-primary);">{r.to}</td>
                <td>{r.duration}</td>
                <td style="color:var(--ink-muted);font-size:0.875rem;">{r.via}</td>
                <td style="font-weight:700;color:#B26A06;font-size:1.0625rem;">{r.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div style="text-align:center;" data-ui>
        <p style="font-size:0.9375rem;color:var(--ink-muted);margin-bottom:1.5rem;">
          Need assistance with tour reservations or 24/7 customer care?
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;">
          <a
            href={`https://www.getyourguide.com/contact/?partner_id=${site.partnerId}&utm_medium=online_publisher&cmp=${site.campaignPrefix}_pricing_help&locale=${langMeta.gygLocale}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--amber"
          >
            <span>GetYourGuide 24/7 Help Centre</span>
            <span>↗</span>
          </a>
          <a
            href="https://wa.me/4915123457858"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--secondary"
          >
            <span>WhatsApp (+49 151 23457858)</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Itinerary Highlight: The Ella to Mirissa Transit Safari -->
  <section class="section" id="transit-safari" style="padding-top:0;">
    <div class="container">
      <div style="background:#16252B;color:#FFFFFF;border-radius:var(--radius-lg);padding:clamp(2rem, 4vw, 3rem);display:grid;grid-template-columns:1fr;gap:2.5rem;align-items:center;" class="md:grid-cols-[1.2fr_1fr]" data-ui>
        <div>
          <span class="section-pill" style="background:rgba(220,139,25,0.2);color:#F3B755;border-color:rgba(220,139,25,0.35);">Signature Itinerary Hack</span>
          <h2 style="font-size:clamp(1.6rem, 2.6vw, 2.25rem);color:#FFFFFF;margin-bottom:1rem;line-height:1.2;">
            The Ella → South Coast Transit Elephant Safari
          </h2>
          <p style="font-size:1.0625rem;color:var(--ink-muted-on-dark);line-height:1.6;margin-bottom:1.5rem;">
            Don't spend 4 hours sitting in an empty transit car. Udawalawe National Park lies directly along the highway corridor between the central highlands and the southern beaches. 
          </p>
          <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:2rem;font-size:0.9375rem;color:#EAE6DF;">
            <div style="display:flex;align-items:flex-start;gap:0.6rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F3B755" stroke-width="2.5" style="margin-top:0.15rem;flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Total Luggage Custody:</strong> Your suitcases stay safely locked inside our air-conditioned vehicle during your 3-hour game drive.</span>
            </div>
            <div style="display:flex;align-items:flex-start;gap:0.6rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F3B755" stroke-width="2.5" style="margin-top:0.15rem;flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Guaranteed Wild Elephants:</strong> Udawalawe's open reservoir grasslands offer Sri Lanka's most reliable year-round elephant sightings.</span>
            </div>
            <div style="display:flex;align-items:flex-start;gap:0.6rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F3B755" stroke-width="2.5" style="margin-top:0.15rem;flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Same-Day Beach Drop-Off:</strong> Arrive at your Mirissa, Weligama, or Galle resort in time for evening ocean cocktails.</span>
            </div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
            <a
              href={`https://www.getyourguide.com/udawalawa-l190151/udawalawe-private-udawalawe-national-park-safari-tour-t318142/?partner_id=QOSQVIQ&utm_medium=online_publisher&cmp=lwf_transit_safari&locale=${langMeta.gygLocale}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--amber"
            >
              <span>Book Udawalawe Safari ($25)</span>
              <span>→</span>
            </a>
            <a
              href="https://wa.me/4915123457858"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--ghost-white"
            >
              <span>Official WhatsApp Helpdesk</span>
              <span>↗</span>
            </a>
          </div>
        </div>
        <div style="border-radius:var(--radius);overflow:hidden;position:relative;aspect-ratio:4/3;border:1px solid rgba(255,255,255,0.15);">
          <img
            src="https://images.unsplash.com/photo-1581852017103-68ac6550407b?auto=format&fit=crop&w=800&q=80"
            alt="Wild Asian elephants in Udawalawe National Park Sri Lanka"
            style="width:100%;height:100%;object-fit:cover;"
            loading="lazy"
          />
          <div style="position:absolute;bottom:1rem;left:1rem;background:rgba(22,37,43,0.88);color:#FFFFFF;padding:0.4rem 0.85rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;">
            Highway Stopover: 3.5 hrs from Ella
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vehicle Fleet Profiles -->
  <section class="section section--cream">
    <div class="container">
      <div class="section-header">
        <span class="section-pill">Dedicated Fleets</span>
        <h2 class="section-title">Our Vehicle Specifications</h2>
        <p class="section-subtitle">
          Modern, insured Japanese vehicles maintained to stringent safety guidelines.
        </p>
      </div>

      <div class="grid-3" data-ui>
        {fleets.map((f) => (
          <div style="background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);padding:2rem;display:flex;flex-direction:column;">
            <h3 style="font-size:1.25rem;font-weight:600;margin-bottom:0.4rem;">
              {f.type}
            </h3>
            <div style="font-size:0.8125rem;font-weight:600;color:var(--accent-amber);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:1rem;">
              {f.capacity}
            </div>
            <p style="font-size:0.9375rem;color:var(--ink-body);line-height:1.55;margin-bottom:1.25rem;">
              {f.idealFor}
            </p>
            <ul style="margin:0;padding-left:1.25rem;font-size:0.875rem;color:var(--ink-muted);line-height:1.6;display:flex;flex-direction:column;gap:0.4rem;">
              {f.features.map((feat) => (
                <li>{feat}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
