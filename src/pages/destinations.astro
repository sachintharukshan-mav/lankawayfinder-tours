---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../data/sites/lankawayfinder.json";

const { regions, tours } = siteData;

const regionHighlights: Record<string, string[]> = {
  "yala-udawalawe": [
    "Track the elusive Sri Lankan leopard in Yala Block 1",
    "Observe wild elephant families grazing at Udawalawe reservoir",
    "Birdwatching for crested serpent eagles and painted storks"
  ],
  "sigiriya-minneriya": [
    "Ascend King Kashyapa's 5th-century granite sky citadel at dawn",
    "Witness the seasonal Minneriya & Kaudulla Wild Elephant Gathering",
    "Explore the ancient golden cave monastery of Dambulla"
  ],
  "ella-hill-country": [
    "Watch the iconic blue express train cross the Nine Arch Bridge",
    "Hike through emerald tea plantations up Little Adam's Peak",
    "Experience the world-renowned Kandy to Nanu Oya scenic railway"
  ],
  "mirissa-galle": [
    "Stroll along the 17th-century coral & granite Dutch sea ramparts",
    "Watch sunset cliff jumpers leap into the surf at Flag Rock bastion",
    "Cruise off Dondra Head trench to encounter oceanic blue whales"
  ],
  "colombo-cmb": [
    "Sample fiery kottu roti and fresh hoppers on a Pettah street food crawl",
    "Dine inside the historic 17th-century Dutch Hospital complex",
    "Stroll the seaside promenade at Galle Face Green at dusk"
  ]
};
---

<BaseLayout
  title="Things to Do in Sri Lanka (2026): Top 5 Regional Corridors | LankaWayfinder"
  description="Explore the best things to do in Sri Lanka: Yala Block 1 leopards, Sigiriya Lion Rock ($36 ticket), Ella Nine Arch Bridge, and Mirissa blue whale cruises."
  currentPath="/destinations/"
>
  <!-- Page Hero -->
  <section class="section section--cream" style="padding-top:clamp(4rem, 6vw, 5.5rem);padding-bottom:clamp(3rem, 5vw, 4.5rem);">
    <div class="container">
      <div class="section-header section-header--left" style="max-width:820px;margin-bottom:0;">
        <span class="section-pill">Explore Sri Lanka</span>
        <h1 style="margin-bottom:1rem;">Things to Do &amp; Island Corridors</h1>
        <p class="section-subtitle">
          Sri Lanka's compact geography lets you journey from arid wildlife savannahs to mist-shrouded mountain peaks and tropical coral coastlines in just a few hours. Explore each regional corridor below.
        </p>

        <!-- JSON-LD BreadcrumbList & ItemList Schema -->
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "BreadcrumbList",
              "itemListElement": [
                {
                  "@type": "ListItem",
                  "position": 1,
                  "name": "Home",
                  "item": "https://lankawayfinder.tours/"
                },
                {
                  "@type": "ListItem",
                  "position": 2,
                  "name": "Things to Do",
                  "item": "https://lankawayfinder.tours/destinations/"
                }
              ]
            },
            {
              "@type": "ItemList",
              "name": "Top 5 Regional Travel Corridors in Sri Lanka (2026)",
              "description": "Sri Lanka's primary safari, cultural triangle, highland tea rail, and southern coast corridors.",
              "numberOfItems": regions.length,
              "itemListElement": regions.map((region, idx) => ({
                "@type": "ListItem",
                "position": idx + 1,
                "url": `https://lankawayfinder.tours/${region.slug}/`,
                "item": {
                  "@type": "TouristDestination",
                  "@id": `https://lankawayfinder.tours/${region.slug}/#destination`,
                  "name": region.name,
                  "description": region.description,
                  "image": region.image,
                  "url": `https://lankawayfinder.tours/${region.slug}/`
                }
              }))
            }
          ]
        })} />
      </div>
    </div>
  </section>

  <!-- Destination Corridors Detailed Showcase -->
  <section class="section">
    <div class="container">
      <div style="display:flex;flex-direction:column;gap:3.5rem;">
        {regions.map((region, idx) => {
          const regionTours = tours.filter((t) => t.regionSlug === region.slug);
          const highlights = regionHighlights[region.slug] || [];
          const isReversed = idx % 2 === 1;

          return (
            <div style={`display:grid;grid-template-columns:1fr;gap:2rem;align-items:center;background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);overflow:hidden;padding:clamp(1.5rem, 3vw, 2.5rem);`}
              class={isReversed ? "md:grid-cols-[1.1fr_1fr]" : "md:grid-cols-[1fr_1.1fr]"}
              data-ui
            >
              <!-- Media Column -->
              <div style={`border-radius:var(--radius);overflow:hidden;aspect-ratio:16/11;position:relative;${isReversed ? "md:order-2" : ""}`}>
                <img
                  src={region.image}
                  alt={region.name}
                  fetchpriority={idx === 0 ? "high" : undefined}
                  loading={idx === 0 ? undefined : "lazy"}
                  style="width:100%;height:100%;object-fit:cover;"
                />
                <div style="position:absolute;bottom:1rem;left:1rem;background:rgba(22,37,43,0.85);color:#FFFFFF;padding:0.4rem 0.85rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;">
                  Best Time: {region.bestTime}
                </div>
              </div>

              <!-- Content Column -->
              <div style={isReversed ? "md:order-1" : ""}>
                <span class="section-pill">{region.tagline}</span>
                <h2 style="font-size:clamp(1.5rem, 2.4vw, 2rem);margin-bottom:0.75rem;">
                  {region.name}
                </h2>
                <p style="font-size:1rem;color:var(--ink-body);line-height:1.6;margin-bottom:1.25rem;">
                  {region.description}
                </p>

                <h4 style="font-family:var(--font-sans);font-size:0.875rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--ink-primary);margin-bottom:0.6rem;">
                  Signature Highlights
                </h4>
                <ul style="list-style:none;padding:0;margin:0 0 1.5rem 0;display:flex;flex-direction:column;gap:0.45rem;font-size:0.9375rem;color:var(--ink-body);">
                  {highlights.map((h) => (
                    <li style="display:flex;align-items:flex-start;gap:0.5rem;">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#DC8B19" stroke-width="2.5" style="margin-top:0.25rem;flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>

                <div style="display:flex;flex-wrap:wrap;gap:0.85rem;align-items:center;">
                  <a href={`/${region.slug}/`} class="btn btn--sm btn--teal">
                    <span>Explore Corridor Guide</span>
                    <span>→</span>
                  </a>
                  {regionTours.length > 0 && (
                    <a href={`/${region.slug}/#tours`} class="btn btn--sm btn--ghost">
                      <span>View {regionTours.length} Experiences</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- 2026 Regional Corridors Quick Comparison Table -->
      <details style="margin-top:3rem;background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);padding:1.25rem 1.5rem;">
        <summary style="font-weight:700;font-size:1.05rem;color:var(--ink-primary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;">
          <span>2026 Sri Lanka Regional Corridors Logistics &amp; Gate Matrix</span>
          <span style="color:var(--accent-amber);font-size:0.875rem;font-weight:600;">View Table ▾</span>
        </summary>
        <div tabindex="0" role="region" aria-labelledby="corridors-matrix-caption" class="pricing-table-container" style="margin-top:1.25rem;overflow-x:auto;">
          <table class="pricing-table">
            <caption id="corridors-matrix-caption" class="sr-only">Sri Lanka regional travel corridors comparison with optimal entry hours, access gates, and transfer logistics</caption>
            <thead>
              <tr>
                <th scope="col">Regional Corridor</th>
                <th scope="col">Focus</th>
                <th scope="col">Optimal Gate Hours</th>
                <th scope="col">Primary Access Gates</th>
                <th scope="col">Transfer &amp; Luggage Protocol</th>
              </tr>
            </thead>
            <tbody>
              {regions.map((region) => (
                <tr>
                  <th scope="row" style="font-weight:700;color:var(--ink-primary);text-align:left;">
                    <a href={`/${region.slug}/`} style="color:var(--ink-primary);text-decoration:underline;">{region.name}</a>
                  </th>
                  <td>{region.tagline}</td>
                  <td style="white-space:nowrap;">{region.bestTime}</td>
                  <td style="font-size:0.875rem;">{region.keyGates}</td>
                  <td style="font-size:0.875rem;color:var(--ink-muted);">{region.transferNote}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>
