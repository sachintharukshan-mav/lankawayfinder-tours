---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../data/sites/lankawayfinder.json";

const { site, stays } = siteData;

function getTripUrl(stay: typeof stays[0]) {
  if (stay.hotelId) {
    return `https://www.trip.com/hotels/detail/?hotelId=${stay.hotelId}&Allianceid=${site.tripAllianceId || "11096275"}&SID=${site.tripSid || "334154717"}&trip_sub1=&trip_sub3=${site.tripSub3 || "D20421816"}`;
  }
  return stay.tripUrl;
}
---

<BaseLayout
  title="Where to Stay in Sri Lanka (2026): 8 Boutique Safari Lodges & Villas | LankaWayfinder"
  description="Hand-picked Sri Lanka accommodation: luxury Yala safari cocoon tents, restored tea planter bungalows in Hatton & Ella, and Galle Fort heritage hotels."
  currentPath="/where-to-stay/"
>
  <!-- Hero Section -->
  <section class="section section--cream" style="padding-top:clamp(4rem, 6vw, 5.5rem);padding-bottom:clamp(3rem, 5vw, 4.5rem);">
    <div class="container">
      <div class="section-header section-header--left" style="max-width:820px;margin-bottom:0;">
        <span class="section-pill">Official Trip.com Accommodation Partner</span>
        <h1 style="margin-bottom:1rem;">Where to Stay in Sri Lanka</h1>
        <p class="section-subtitle">
          From luxury cocoon tented camps beside wild leopard territory to 150-year-old restored tea planter bungalows in the misty highlands, here are our field-tested recommendations. Book securely via our official partnership with Trip.com for best rate protection and flexible cancellation on eligible dates.
        </p>

        <!-- JSON-LD BreadcrumbList & Hotel ItemList Schema -->
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "BreadcrumbList",
              "itemListElement": [
                {
                  "@type": "ListItem",
                  "position": 1,
                  "name": "Home",
                  "item": "https://lankawayfinder.tours/"
                },
                {
                  "@type": "ListItem",
                  "position": 2,
                  "name": "Where to Stay",
                  "item": "https://lankawayfinder.tours/where-to-stay/"
                }
              ]
            },
            {
              "@type": "ItemList",
              "name": "Curated Boutique Lodges & Heritage Villas in Sri Lanka",
              "description": "Hand-picked safari lodges, tea planter bungalows, and colonial villas in Sri Lanka with direct Trip.com partner rate booking.",
              "numberOfItems": stays.length,
              "itemListElement": stays.map((stay, idx) => ({
                "@type": "ListItem",
                "position": idx + 1,
                "url": `https://lankawayfinder.tours/where-to-stay/#${stay.id}`,
                "item": {
                  "@type": "Hotel",
                  "@id": `https://lankawayfinder.tours/where-to-stay/#${stay.id}`,
                  "name": stay.name,
                  "description": stay.description,
                  "image": stay.image,
                  "priceRange": stay.priceTier,
                  "address": {
                    "@type": "PostalAddress",
                    "addressRegion": stay.region,
                    "addressCountry": "LK"
                  },
                  "url": `https://lankawayfinder.tours/where-to-stay/#${stay.id}`
                }
              }))
            }
          ]
        })} />
      </div>
    </div>
  </section>

  <!-- Hotel Grid -->
  <section class="section">
    <div class="container">
      <div class="grid-2" data-ui>
        {stays.map((stay) => {
          const tripUrl = getTripUrl(stay);
          return (
            <article class="stay-card" id={stay.id}>
              <!-- Stay Image -->
              <a
                href={tripUrl}
                target="_blank"
                rel="sponsored noopener noreferrer"
                class="stay-card__media"
                aria-label={`View ${stay.name} rates on Trip.com`}
              >
                <img
                  src={stay.image}
                  alt={stay.name}
                  loading="lazy"
                  width="700"
                  height="440"
                />
                <span class="stay-card__tier">
                  {stay.priceTier}
                </span>
              </a>

              <!-- Stay Content -->
              <div class="stay-card__body">
                <div class="stay-card__region">
                  {stay.region} • {stay.category}
                </div>

                <h2 class="stay-card__name">
                  <a
                    href={tripUrl}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                  >
                    {stay.name}
                  </a>
                </h2>

                <p class="stay-card__desc">
                  {stay.description}
                </p>

                <!-- Amenity Pills -->
                <ul class="stay-card__amenities">
                  {stay.highlights.map((h) => (
                    <li class="stay-card__amenity-pill">
                      {h}
                    </li>
                  ))}
                </ul>

                <!-- Card Footer with Trip.com Partner Link -->
                <div class="stay-card__footer">
                  <div style="display:flex;flex-direction:column;gap:0.2rem;">
                    <span style="font-size:0.8125rem;font-weight:600;color:var(--accent-amber);">
                      Trip.com Partner
                    </span>
                    <span style="font-size:0.8125rem;color:var(--ink-muted);">
                      Best rates &amp; flexible cancel
                    </span>
                  </div>

                  <a
                    href={tripUrl}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                    class="btn btn--sm btn--teal"
                    aria-label={`See rates & availability for ${stay.name}`}
                  >
                    <span>See rates &amp; availability</span>
                    <span>↗</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Quick Comparison Matrix for AI & Travelers -->
      <details style="margin-top:2.5rem;background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);padding:1.25rem 1.5rem;">
        <summary style="font-weight:700;font-size:1.05rem;color:var(--ink-primary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;">
          <span>2026 Curated Sri Lanka Boutique Stays Comparison Matrix ({stays.length} Properties)</span>
          <span style="color:var(--accent-amber);font-size:0.875rem;font-weight:600;">View Table ▾</span>
        </summary>
        <div tabindex="0" role="region" aria-labelledby="stays-matrix-caption" class="pricing-table-container" style="margin-top:1.25rem;overflow-x:auto;">
          <table class="pricing-table">
            <caption id="stays-matrix-caption" class="sr-only">Comparison of 8 verified Sri Lanka boutique lodges, tea bungalows, and heritage hotels</caption>
            <thead>
              <tr>
                <th scope="col">Property Name</th>
                <th scope="col">Region / Corridor</th>
                <th scope="col">Category</th>
                <th scope="col">Price Tier</th>
                <th scope="col">Key Highlights</th>
              </tr>
            </thead>
            <tbody>
              {stays.map((stay) => (
                <tr>
                  <th scope="row" style="font-weight:700;color:var(--ink-primary);text-align:left;">
                    <a href={`#${stay.id}`} style="color:var(--ink-primary);text-decoration:underline;">{stay.name}</a>
                  </th>
                  <td>{stay.region}</td>
                  <td>{stay.category}</td>
                  <td style="font-weight:700;color:#B26A06;">{stay.priceTier}</td>
                  <td style="font-size:0.875rem;color:var(--ink-muted);">{stay.highlights.join(" • ")}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>

      <!-- Editorial Note -->
      <div style="margin-top:3.5rem;background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);padding:2rem;text-align:center;max-width:820px;margin-left:auto;margin-right:auto;" data-ui>
        <h3 style="font-size:1.25rem;margin-bottom:0.6rem;">Booking Coordination &amp; Chauffeur Drop-offs</h3>
        <p style="font-size:0.9375rem;color:var(--ink-body);line-height:1.6;margin-bottom:1.25rem;">
          All our private chauffeur transfer drivers have direct route coordinates and gated access passes for these luxury properties. We coordinate directly with reception for luggage deliveries during your activities.
        </p>
        <a href="/getting-around/" class="btn btn--sm btn--amber">
          <span>Explore Chauffeur Transfers</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
