---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteData from "../data/sites/lankawayfinder.json";

const { site, routePricing } = siteData;

const protocols = [
  {
    step: "I",
    title: "Air-Conditioned Highway Dispatch",
    desc: "Your private chauffeur meets you at CMB Bandaranaike International Airport Arrivals Canopy or your city hotel lobby in a clean, insured vehicle with cold bottled water and luggage assistance."
  },
  {
    step: "II",
    title: "Secure Gate Luggage Custody",
    desc: "When transferring between destinations (such as Ella to Mirissa via Udawalawe Safari, or Kandy to Ella by scenic train), your heavy baggage remains safely locked in the vehicle while you enjoy the excursion."
  },
  {
    step: "III",
    title: "Direct Doorstep Handover",
    desc: "At the end of your safari or train ride, your driver meets you promptly at the gate exit or train station platform, transporting you directly to your next boutique hotel or beach villa."
  }
];

const fleets = [
  {
    type: "Premium Sedan (Toyota Axio / Prius)",
    capacity: "Up to 3 Passengers • 2 Large Suitcases",
    idealFor: "Couples & solo travelers connecting between airports and coastal resorts.",
    features: ["Dual air-conditioning", "Full expressway toll coverage", "USB mobile charging ports"]
  },
  {
    type: "High-Roof Van (Toyota KDH Commuter)",
    capacity: "Up to 7 Passengers • 8 Large Bags",
    idealFor: "Families and small groups with surfboards, child seats, and extensive safari camera equipment.",
    features: ["Elevated panoramic windows", "Separate rear luggage hold", "Reclining captain chairs"]
  },
  {
    type: "Compact SUV (Toyota Vezel / Raize)",
    capacity: "Up to 3 Passengers • 3 Medium Bags",
    idealFor: "Scenic hill country mountain passes and tea plantation estate switchbacks.",
    features: ["High road clearance", "Smooth suspension", "Quiet hybrid engine"]
  }
];
---

<BaseLayout
  title="Getting Around Sri Lanka (2026): Chauffeur Fares, Tolls & Airport Transfers"
  description="2026 Sri Lanka private driver rates ($50–$65/day), fixed CMB airport transfer prices ($62 to Galle, $78 to Sigiriya), and safari gate luggage custody."
  currentPath="/getting-around/"
>
  <!-- Page Hero -->
  <section class="section section--cream" style="padding-top:clamp(4rem, 6vw, 5.5rem);padding-bottom:clamp(3rem, 5vw, 4.5rem);">
    <div class="container">
      <div class="section-header section-header--left" style="max-width:820px;margin-bottom:0;">
        <span class="section-pill">Island Transport Logistics</span>
        <h1 style="margin-bottom:1rem;">Getting Around Sri Lanka: Private Chauffeur Transfers</h1>
        <p class="section-subtitle">
          Navigating Sri Lanka's mountain passes and expressways requires reliable transit. We coordinate licensed private drivers with fixed highway pricing and gate luggage custody so you never have to haul baggage on public buses.
        </p>
      </div>
    </div>
  </section>

  <!-- 3-Step Handover Protocol -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-pill">Route Coordination</span>
        <h2 class="section-title">The Three-Step Transfer Protocol</h2>
        <p class="section-subtitle">
          How our private chauffeur network solves luggage security during safaris and train rides.
        </p>
      </div>

      <div class="grid-3" data-ui>
        {protocols.map((p) => (
          <div style="background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);padding:2rem;display:flex;flex-direction:column;">
            <div style="font-family:var(--font-serif);font-size:2rem;font-weight:700;color:var(--accent-amber);line-height:1;margin-bottom:1rem;">
              {p.step}
            </div>
            <h3 style="font-size:1.25rem;font-weight:600;margin-bottom:0.75rem;">
              {p.title}
            </h3>
            <p style="font-size:0.9375rem;color:var(--ink-body);line-height:1.6;margin:0;">
              {p.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Route Pricing Ledger -->
  <section class="section section--cream" id="pricing">
    <div class="container">
      <div class="section-header">
        <span class="section-pill">Transparent Pricing</span>
        <h2 class="section-title">Standard Route Pricing Ledger</h2>
        <p class="section-subtitle">
          All prices are flat estimates in USD, including expressway tolls, parking fees, and vehicle fuel.
        </p>
      </div>

      <div class="pricing-table-container" style="max-width:960px;margin:0 auto 2.5rem auto;" data-ui>
        <table class="pricing-table">
          <thead>
            <tr>
              <th>Departure Point</th>
              <th>Destination</th>
              <th>Typical Drive Time</th>
              <th>Primary Highway Corridor</th>
              <th>Flat Vehicle Rate</th>
            </tr>
          </thead>
          <tbody>
            {routePricing.map((r) => (
              <tr>
                <td style="font-weight:600;color:var(--ink-primary);">{r.from}</td>
                <td style="font-weight:600;color:var(--ink-primary);">{r.to}</td>
                <td>{r.duration}</td>
                <td style="color:var(--ink-muted);font-size:0.875rem;">{r.via}</td>
                <td style="font-weight:700;color:#B26A06;font-size:1.0625rem;">{r.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div style="text-align:center;" data-ui>
        <p style="font-size:0.9375rem;color:var(--ink-muted);margin-bottom:1.5rem;">
          Need assistance with tour reservations or 24/7 customer care?
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;">
          <a
            href={`https://www.getyourguide.com/contact/?partner_id=${site.partnerId}&utm_medium=online_publisher&cmp=${site.campaignPrefix}_pricing_help`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--amber"
          >
            <span>GetYourGuide 24/7 Help Centre</span>
            <span>↗</span>
          </a>
          <a
            href="https://wa.me/4915123457858"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--secondary"
          >
            <span>WhatsApp (+49 151 23457858)</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Comparison Ledger: Private Chauffeur vs Public Transit vs Taxi Apps -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-pill">Comparison Analysis</span>
        <h2 class="section-title">How Private Chauffeurs Compare</h2>
        <p class="section-subtitle">
          Evaluating safety, luggage handling, and total transit efficiency across Sri Lanka.
        </p>
      </div>

      <div class="pricing-table-container" style="max-width:1040px;margin:0 auto;" data-ui>
        <table class="pricing-table">
          <thead>
            <tr>
              <th>Travel Option</th>
              <th>Baggage &amp; Luggage</th>
              <th>Schedule Flexibility</th>
              <th>Comfort &amp; AC</th>
              <th>Best Used For</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="font-weight:700;color:var(--ink-primary);">Private Chauffeur</td>
              <td style="color:#1D6335;font-weight:600;">Locked securely in vehicle during tours</td>
              <td style="color:#1D6335;font-weight:600;">Flexible departure; pause at scenic lookouts</td>
              <td style="color:#1D6335;font-weight:600;">Guaranteed private AC vehicle</td>
              <td>Multi-destination routes, airport arrivals &amp; families</td>
            </tr>
            <tr>
              <td style="font-weight:600;color:var(--ink-primary);">Scenic Rail (2nd/3rd Class)</td>
              <td style="color:#B03A2E;">High theft risk; unreserved racks</td>
              <td style="color:#B03A2E;">Fixed railway timetables; frequent delays</td>
              <td style="color:var(--ink-muted);">Open-window airflow; no AC in 2nd/3rd class</td>
              <td>The scenic Nanu Oya to Ella mountain segment only</td>
            </tr>
            <tr>
              <td style="font-weight:600;color:var(--ink-primary);">Local Taxi Apps (PickMe/Uber)</td>
              <td style="color:var(--ink-muted);">Varies by driver; cannot leave bags during excursions</td>
              <td style="color:#B03A2E;">Rarely available outside Colombo &amp; Kandy</td>
              <td style="color:var(--ink-muted);">Standard small hatchbacks without AC on request</td>
              <td>Short 10-minute intra-city hops within Colombo</td>
            </tr>
            <tr>
              <td style="font-weight:600;color:var(--ink-primary);">Public Red Buses (CTB)</td>
              <td style="color:#B03A2E;">No luggage storage; crowded aisles</td>
              <td style="color:#B03A2E;">Aggressive driving on narrow mountain curves</td>
              <td style="color:#B03A2E;">No air-conditioning; packed to standing room</td>
              <td>Budget backpackers on very short rural transfers</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Featured Itinerary Highlight: The Ella to Mirissa Transit Safari -->
  <section class="section" id="transit-safari" style="padding-top:0;">
    <div class="container">
      <div style="background:#16252B;color:#FFFFFF;border-radius:var(--radius-lg);padding:clamp(2rem, 4vw, 3rem);display:grid;grid-template-columns:1fr;gap:2.5rem;align-items:center;" class="md:grid-cols-[1.2fr_1fr]" data-ui>
        <div>
          <span class="section-pill" style="background:rgba(220,139,25,0.2);color:#F3B755;border-color:rgba(220,139,25,0.35);">Signature Itinerary Hack</span>
          <h2 style="font-size:clamp(1.6rem, 2.6vw, 2.25rem);color:#FFFFFF;margin-bottom:1rem;line-height:1.2;">
            The Ella → South Coast Transit Elephant Safari
          </h2>
          <p style="font-size:1.0625rem;color:var(--ink-muted-on-dark);line-height:1.6;margin-bottom:1.5rem;">
            Don't spend 4 hours sitting in an empty transit car. Udawalawe National Park lies directly along the highway corridor between the central highlands and the southern beaches. 
          </p>
          <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:2rem;font-size:0.9375rem;color:#EAE6DF;">
            <div style="display:flex;align-items:flex-start;gap:0.6rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F3B755" stroke-width="2.5" style="margin-top:0.15rem;flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Total Luggage Custody:</strong> Your suitcases stay safely locked inside our air-conditioned vehicle during your 3-hour game drive.</span>
            </div>
            <div style="display:flex;align-items:flex-start;gap:0.6rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F3B755" stroke-width="2.5" style="margin-top:0.15rem;flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Guaranteed Wild Elephants:</strong> Udawalawe's open reservoir grasslands offer Sri Lanka's most reliable year-round elephant sightings.</span>
            </div>
            <div style="display:flex;align-items:flex-start;gap:0.6rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F3B755" stroke-width="2.5" style="margin-top:0.15rem;flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span><strong>Same-Day Beach Drop-Off:</strong> Arrive at your Mirissa, Weligama, or Galle resort in time for evening ocean cocktails.</span>
            </div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
            <a
              href="https://www.getyourguide.com/udawalawa-l190151/udawalawe-private-udawalawe-national-park-safari-tour-t318142/?partner_id=QOSQVIQ&utm_medium=online_publisher&cmp=lwf_transit_safari"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--amber"
            >
              <span>Book Udawalawe Safari ($25)</span>
              <span>→</span>
            </a>
            <a
              href="https://wa.me/4915123457858"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--ghost-white"
            >
              <span>Official WhatsApp Helpdesk</span>
              <span>↗</span>
            </a>
          </div>
        </div>
        <div style="border-radius:var(--radius);overflow:hidden;position:relative;aspect-ratio:4/3;border:1px solid rgba(255,255,255,0.15);">
          <img
            src="https://images.unsplash.com/photo-1581852017103-68ac6550407b?auto=format&fit=crop&w=800&q=80"
            alt="Wild Asian elephants in Udawalawe National Park Sri Lanka"
            style="width:100%;height:100%;object-fit:cover;"
            loading="lazy"
          />
          <div style="position:absolute;bottom:1rem;left:1rem;background:rgba(22,37,43,0.88);color:#FFFFFF;padding:0.4rem 0.85rem;border-radius:9999px;font-size:0.8125rem;font-weight:600;">
            Highway Stopover: 3.5 hrs from Ella
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vehicle Fleet Profiles -->
  <section class="section section--cream">
    <div class="container">
      <div class="section-header">
        <span class="section-pill">Dedicated Fleets</span>
        <h2 class="section-title">Our Vehicle Specifications</h2>
        <p class="section-subtitle">
          Modern, insured Japanese vehicles maintained to stringent safety guidelines.
        </p>
      </div>

      <div class="grid-3" data-ui>
        {fleets.map((f) => (
          <div style="background:#FFFFFF;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);padding:2rem;display:flex;flex-direction:column;">
            <h3 style="font-size:1.25rem;font-weight:600;margin-bottom:0.4rem;">
              {f.type}
            </h3>
            <div style="font-size:0.8125rem;font-weight:600;color:var(--accent-amber);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:1rem;">
              {f.capacity}
            </div>
            <p style="font-size:0.9375rem;color:var(--ink-body);line-height:1.55;margin-bottom:1.25rem;">
              {f.idealFor}
            </p>
            <ul style="list-style:none;padding:0;margin:auto 0 0 0;display:flex;flex-direction:column;gap:0.4rem;font-size:0.875rem;color:var(--ink-muted);">
              {f.features.map((feat) => (
                <li style="display:flex;align-items:center;gap:0.5rem;">
                  <span style="color:var(--accent-amber);font-weight:bold;">•</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- High-Intent AEO FAQs (Answer Engine Optimization) -->
  <section class="section section--white" id="faq">
    <div class="container" style="max-width:880px;">
      <div class="section-header">
        <span class="section-pill">Field Logistics</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-subtitle">
          Direct logistics guidance for private drivers, train luggage sync, and safari transfers in Sri Lanka.
        </p>
      </div>

      <div style="display:flex;flex-direction:column;gap:1.25rem;" data-ui>
        <details style="background:var(--bg-surface-raised);border-radius:var(--radius);border:1px solid var(--border-subtle);padding:1.25rem 1.5rem;" open>
          <summary style="font-weight:700;font-size:1.0625rem;color:var(--ink-primary);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">
            <span>How much does a private driver in Sri Lanka cost per day in 2026?</span>
            <span style="color:var(--accent-amber);font-size:1.25rem;font-weight:bold;">+</span>
          </summary>
          <p style="margin-top:0.85rem;color:var(--ink-body);font-size:0.9375rem;line-height:1.65;">
            In 2026, an English-speaking private driver with an air-conditioned vehicle in Sri Lanka typically costs <strong>$50 to $65 USD per day</strong> for a standard sedan, and <strong>$80 to $95 USD per day</strong> for a high-clearance SUV or passenger van. This daily rate covers vehicle fuel, comprehensive passenger insurance, expressway tolls, and the driver's meals and accommodation.
          </p>
        </details>

        <details style="background:var(--bg-surface-raised);border-radius:var(--radius);border:1px solid var(--border-subtle);padding:1.25rem 1.5rem;">
          <summary style="font-weight:700;font-size:1.0625rem;color:var(--ink-primary);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">
            <span>Can my luggage stay in the vehicle during an elephant safari or hike?</span>
            <span style="color:var(--accent-amber);font-size:1.25rem;font-weight:bold;">+</span>
          </summary>
          <p style="margin-top:0.85rem;color:var(--ink-body);font-size:0.9375rem;line-height:1.65;">
            Yes. When you book a corridor chauffeur transfer with LankaWayfinder, your driver retains custody of the locked, air-conditioned vehicle at the national park gate (Udawalawe, Yala, or Minneriya) or railway station while you enjoy your 4x4 game drive or scenic train ride. Your luggage never sits unattended.
          </p>
        </details>

        <details style="background:var(--bg-surface-raised);border-radius:var(--radius);border:1px solid var(--border-subtle);padding:1.25rem 1.5rem;">
          <summary style="font-weight:700;font-size:1.0625rem;color:var(--ink-primary);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">
            <span>What is the fastest way from Colombo Airport (CMB) to Sigiriya or Galle?</span>
            <span style="color:var(--accent-amber);font-size:1.25rem;font-weight:bold;">+</span>
          </summary>
          <p style="margin-top:0.85rem;color:var(--ink-body);font-size:0.9375rem;line-height:1.65;">
            The fastest option is a pre-arranged private chauffeur directly from the CMB terminal arrivals canopy (pre-book your fixed-rate airport transfer online at <a href="https://www.lankawayfinder.com" target="_blank" rel="noopener noreferrer" style="color:var(--accent-amber);text-decoration:underline;font-weight:600;">LankaWayfinder.com</a>). The journey to Galle or Mirissa takes approximately <strong>2.0 hours via the Southern Expressway (E01)</strong> (flat fare: $62 USD). The journey to Sigiriya or Dambulla takes approximately <strong>3.5 hours via the Central Expressway</strong> (flat fare: $78 USD).
          </p>
        </details>

        <details style="background:var(--bg-surface-raised);border-radius:var(--radius);border:1px solid var(--border-subtle);padding:1.25rem 1.5rem;">
          <summary style="font-weight:700;font-size:1.0625rem;color:var(--ink-primary);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">
            <span>Are national park entrance fees included in private safari jeep hires?</span>
            <span style="color:var(--accent-amber);font-size:1.25rem;font-weight:bold;">+</span>
          </summary>
          <p style="margin-top:0.85rem;color:var(--ink-body);font-size:0.9375rem;line-height:1.65;">
            Standard roadside jeep hires only cover vehicle rental; travelers must pay the Department of Wildlife Conservation (DWC) foreign entry fee ($30–$35 USD + 15% VAT per person) at the ticket counter. We recommend booking all-inclusive packages that bundle the private 4x4, licensed tracker, park permits, and hotel pickup to bypass counter queues.
          </p>
        </details>
      </div>

      <!-- JSON-LD BreadcrumbList & FAQPage Schema for Search Engines and AI Answer Engines -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://lankawayfinder.tours/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Getting Around",
                "item": "https://lankawayfinder.tours/getting-around/"
              }
            ]
          },
          {
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "How much does a private driver in Sri Lanka cost per day in 2026?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "In 2026, an English-speaking private driver with an air-conditioned vehicle in Sri Lanka typically costs $50 to $65 USD per day for a standard sedan, and $80 to $95 USD per day for a high-clearance SUV or passenger van. This daily rate covers vehicle fuel, comprehensive passenger insurance, expressway tolls, and the driver's meals and accommodation."
                }
              },
              {
                "@type": "Question",
                "name": "Can my luggage stay in the vehicle during an elephant safari or hike?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. When you book a corridor chauffeur transfer with LankaWayfinder, your driver retains custody of the locked, air-conditioned vehicle at the national park gate or railway station while you enjoy your 4x4 game drive or scenic train ride."
                }
              },
              {
                "@type": "Question",
                "name": "What is the fastest way from Colombo Airport (CMB) to Sigiriya or Galle?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The fastest option is a pre-arranged private chauffeur directly from the CMB terminal arrivals canopy. The journey to Galle or Mirissa takes approximately 2.0 hours via the Southern Expressway (E01) ($62 USD). The journey to Sigiriya takes approximately 3.5 hours via the Central Expressway ($78 USD)."
                }
              },
              {
                "@type": "Question",
                "name": "Are national park entrance fees included in private safari jeep hires?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Standard roadside jeep hires only cover vehicle rental; travelers must pay the Department of Wildlife Conservation (DWC) foreign entry fee ($30–$35 USD + 15% VAT per person) at the ticket counter. We recommend booking all-inclusive packages that bundle the private 4x4, tracker, and park permits."
                }
              }
            ]
          }
        ]
      })} />
    </div>
  </section>

  <!-- Dark Slate CTA Band: Official GetYourGuide Support -->
  <section class="section section--dark" style="text-align:center;">
    <div class="container" style="max-width:760px;">
      <span class="section-pill section-pill--dark">Official 24/7 Support</span>
      <h2 style="font-size:clamp(1.85rem, 3.2vw, 2.75rem);color:#FFFFFF;margin-bottom:1rem;">
        Need help with your bookings or route?
      </h2>
      <p style="font-size:1.125rem;color:var(--ink-muted-on-dark);line-height:1.6;margin-bottom:2rem;">
        GetYourGuide's customer care team is available 24 hours a day for instant booking modifications, cancellations, and driver meeting spot assistance.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;" data-ui>
        <a
          href={`https://www.getyourguide.com/contact/?partner_id=${site.partnerId}&utm_medium=online_publisher&cmp=${site.campaignPrefix}_getting_around_cta`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--amber"
        >
          <span>GetYourGuide Help Centre</span>
          <span>↗</span>
        </a>
        <a
          href="https://wa.me/4915123457858"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--ghost-white"
        >
          <span>WhatsApp (+49 151 23457858)</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
