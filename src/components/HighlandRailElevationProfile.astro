<!-- Embedded JSON Data for Client Scrubbing -->
<script type="application/json" id="rail-profile-data" set:html={JSON.stringify(tData)} />

<script>
  function initRailElevation() {
    const container = document.getElementById("rail-elevation");
    if (!container) return;

    const rawDataEl = document.getElementById("rail-profile-data");
    if (!rawDataEl) return;

    let data;
    try {
      data = JSON.parse(rawDataEl.textContent || "{}");
    } catch {
      return;
    }

    const stations = data.stations || [];
    const buttons = container.querySelectorAll<HTMLButtonElement>(".scrub-pill");
    const chartNodes = container.querySelectorAll<SVGCircleElement>(".chart-node");

    const dosDist = document.getElementById("dos-dist");
    const dosName = document.getElementById("dos-name");
    const dosSide = document.getElementById("dos-side");
    const dosAlt = document.getElementById("dos-alt");
    const dosTemp = document.getElementById("dos-temp");
    const dosScenic = document.getElementById("dos-scenic");
    const dosLandmark = document.getElementById("dos-landmark");
    const dosTip = document.getElementById("dos-tip");

    function selectStation(idx: number) {
      const st = stations[idx];
      if (!st) return;

      // Update button active state
      buttons.forEach((btn, bIdx) => {
        const isActive = bIdx === idx;
        btn.classList.toggle("scrub-pill--active", isActive);
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      // Highlight active chart node
      chartNodes.forEach((node) => {
        const isMatch = node.getAttribute("data-node") === st.id;
        if (isMatch) {
          node.setAttribute("stroke-width", "5");
          node.setAttribute("r", node.classList.contains("chart-node--summit") ? "10" : "8");
        } else {
          node.setAttribute("stroke-width", "3");
          node.setAttribute("r", node.classList.contains("chart-node--summit") ? "8" : "6");
        }
      });

      // Update text fields
      if (dosDist) dosDist.textContent = st.dist;
      if (dosName) dosName.textContent = st.name;
      if (dosAlt) dosAlt.textContent = `${st.altM} m (${st.altFt} ft)`;
      if (dosTemp) dosTemp.textContent = st.temp;
      if (dosScenic) dosScenic.textContent = st.scenic;
      if (dosLandmark) dosLandmark.textContent = st.landmark;
      if (dosTip) dosTip.textContent = st.tip;

      if (dosSide) {
        const sideVal = st.side === "RIGHT" ? data.rightSide : st.side === "LEFT" ? data.leftSide : data.bothSides;
        dosSide.textContent = sideVal;
      }
    }

    buttons.forEach((btn, idx) => {
      btn.addEventListener("click", () => selectStation(idx));
      btn.addEventListener("mouseenter", () => selectStation(idx));
    });

    chartNodes.forEach((node) => {
      const nodeId = node.getAttribute("data-node");
      const idx = stations.findIndex((s: any) => s.id === nodeId);
      if (idx !== -1) {
        node.style.cursor = "pointer";
        node.addEventListener("click", () => selectStation(idx));
        node.addEventListener("mouseenter", () => selectStation(idx));
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRailElevation);
  } else {
    initRailElevation();
  }
</script>

