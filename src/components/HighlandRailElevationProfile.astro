---

<div class="rail-elevation" id="rail-elevation" data-ui>
  <!-- Component Header -->
  <div class="rail-elevation__header">
    <div class="rail-elevation__badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
        <line x1="4" y1="22" x2="4" y2="15" />
      </svg>
      <span>{tData.badge}</span>
    </div>
    <h3 class="rail-elevation__title">{tData.title}</h3>
    <p class="rail-elevation__subtitle">{tData.subtitle}</p>
  </div>

  <!-- Interactive Elevation Chart (SVG) -->
  <div class="rail-elevation__chart-wrap">
    <div class="rail-elevation__chart-overlay">
      <span class="alt-flag alt-flag--max">Summit: 1,897m (Pattipola)</span>
      <span class="alt-flag alt-flag--min">Start: 480m (Peradeniya)</span>
    </div>

    <svg
      viewBox="0 0 800 240"
      preserveAspectRatio="none"
      class="rail-elevation__svg"
      aria-label="Highland Railway Elevation Profile Diagram"
    >
      <defs>
        <linearGradient id="elevationGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#DC8B19" stop-opacity="0.45" />
          <stop offset="40%" stop-color="#1D6335" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#16252B" stop-opacity="0.02" />
        </linearGradient>
      </defs>

      <!-- Grid lines -->
      <line x1="50" y1="40" x2="750" y2="40" stroke="rgba(22, 37, 43, 0.08)" stroke-dasharray="4" />
      <line x1="50" y1="100" x2="750" y2="100" stroke="rgba(22, 37, 43, 0.08)" stroke-dasharray="4" />
      <line x1="50" y1="160" x2="750" y2="160" stroke="rgba(22, 37, 43, 0.08)" stroke-dasharray="4" />
      <line x1="50" y1="210" x2="750" y2="210" stroke="rgba(22, 37, 43, 0.12)" />

      <!-- Elevation Area & Line -->
      <!-- Points: Peradeniya (50, 195) -> Hatton (225, 115) -> Nanu Oya (400, 75) -> Pattipola (575, 35) -> Ella (750, 135) -->
      <path
