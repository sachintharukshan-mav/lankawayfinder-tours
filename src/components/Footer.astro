---
import siteData from "../data/sites/lankawayfinder.json";
import { type SupportedLanguage, defaultLang, languages, getLocalizedUrl } from "../i18n/languages";
import { useTranslations } from "../i18n/ui";

interface Props {
  currentLang?: SupportedLanguage;
}

const { currentLang = defaultLang } = Astro.props;
const { site, regions } = siteData;
const t = useTranslations(currentLang);
const langMeta = languages[currentLang] || languages[defaultLang];
const localeQuery = currentLang !== defaultLang ? `&locale=${langMeta.gygLocale}` : "";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Partner Badge -->
      <div>
        <a href={getLocalizedUrl(currentLang, "/")} class="brand-link" style="margin-bottom:1.25rem;" aria-label="LankaWayfinder Home">
          <div class="brand-icon" style="background:#243B45;" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" stroke="#FDF9F2" stroke-width="1.75"/>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="#DC8B19" stroke="#DC8B19"/>
            </svg>
          </div>
          <span class="brand-text" style="color:#FFFFFF;">
            LankaWayfinder<span class="brand-suffix">.tours</span>
          </span>
        </a>

        <p style="font-size:0.9375rem;line-height:1.6;color:var(--ink-muted-on-dark);margin-bottom:1.5rem;max-width:34ch;">
          {t("footer.tagline")}
        </p>

        <!-- Official GetYourGuide Partner Badge -->
        <div style="display:inline-flex;align-items:center;gap:0.6rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);padding:0.5rem 0.85rem;border-radius:9999px;font-size:0.8125rem;color:#FDF9F2;">
          <span style="width:8px;height:8px;border-radius:50%;background:#DC8B19;display:inline-block;"></span>
          <span style="font-weight:600;">GetYourGuide Authorised Partner</span>
        </div>
      </div>

      <!-- Col 2: Experiences & Tours -->
      <div>
        <div class="footer-heading">{t("nav.tours")}</div>
        <ul class="footer-links">
          <li><a href={getLocalizedUrl(currentLang, "/tours/")}>{t("btn.view_all_tours")}</a></li>
          <li><a href={getLocalizedUrl(currentLang, "/destinations/")}>{t("nav.destinations")}</a></li>
          <li><a href={getLocalizedUrl(currentLang, "/where-to-stay/")}>{t("nav.stay")}</a></li>
          <li><a href={getLocalizedUrl(currentLang, "/getting-around/")}>{t("nav.transport")}</a></li>
          <li><a href={getLocalizedUrl(currentLang, "/tours/#safari")}>{t("btn.filter_safari")}</a></li>
          <li><a href={getLocalizedUrl(currentLang, "/tours/#culture")}>{t("btn.filter_culture")}</a></li>
        </ul>
      </div>

      <!-- Col 3: Regional Corridors -->
      <div>
        <div class="footer-heading">{t("footer.regions")}</div>
        <ul class="footer-links">
          {regions.map((reg) => (
            <li>
              <a href={getLocalizedUrl(currentLang, `/${reg.slug}/`)}>
                {reg.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Insider Intelligence & Dispatch -->
      <div>
        <div class="footer-heading">{t("nav.guides")}</div>
        <ul class="footer-links">
          <li><a href={getLocalizedUrl(currentLang, "/travel-guide/")}>{t("nav.guides")}</a></li>
          <li><a href={getLocalizedUrl(currentLang, "/getting-around/#pricing")}>{t("btn.calc_driver")}</a></li>
          <li><a href={getLocalizedUrl(currentLang, "/contact/")}>{t("nav.contact")}</a></li>
          <li><a href={getLocalizedUrl(currentLang, "/affiliate-disclosure/")}>{t("footer.disclosure")}</a></li>
          <li style="margin-top:0.75rem;">
            <a
              href={`https://www.getyourguide.com/contact/?partner_id=${site.partnerId}&utm_medium=online_publisher&cmp=${site.campaignPrefix}_footer_help_${currentLang}${localeQuery}`}
              target="_blank"
              rel="noopener noreferrer"
              style="display:inline-flex;align-items:center;gap:0.4rem;color:#F3B755;font-weight:600;"
            >
              <span>GetYourGuide 24/7 Help Centre</span>
              <span>↗</span>
            </a>
          </li>
          <li style="font-size:0.8125rem;color:var(--ink-muted-on-dark);">
            Toll-Free (US/CA): <a href="tel:+18559571272" style="color:#FFFFFF;text-decoration:underline;">+1 855 957 1272</a>
          </li>
          <li style="font-size:0.8125rem;color:var(--ink-muted-on-dark);">
            International: <a href="tel:+493056839445" style="color:#FFFFFF;text-decoration:underline;">+49 30 56839445</a>
          </li>
          <li style="font-size:0.8125rem;margin-top:0.25rem;">
            <a
              href="https://wa.me/4915123457858"
              target="_blank"
              rel="noopener noreferrer"
              style="color:#F3B755;text-decoration:underline;"
            >
              Official WhatsApp: +49 151 23457858
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Colophon -->
    <div class="footer-bottom">
      <div style="max-width:76ch;line-height:1.5;">
        We partner with GetYourGuide for verified tours and Trip.com for hotel stays. When you book via links on this site, we may earn an affiliate commission at no additional cost to you.
      </div>
      <div>
        &copy; {new Date().getFullYear()} LankaWayfinder.tours. All rights reserved.
      </div>
    </div>
  </div>
</footer>
