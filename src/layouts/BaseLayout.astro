---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { languages, allLanguages, defaultLang, getPathWithoutLang, type SupportedLanguage } from "../i18n/languages";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  lang?: SupportedLanguage;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
}

const {
  title = "LankaWayfinder.tours | Sri Lanka Safaris, Chauffeurs & Island Guide (2026)",
  description = "Independent Sri Lanka route coordination: verified 4x4 wildlife safaris in Yala & Udawalawe, Kandy-to-Ella train solutions, and fixed-rate chauffeur transfers.",
  currentPath = "/",
  lang,
  noindex = false,
  ogImage = "https://images.unsplash.com/photo-1566296314736-6eaac1ca0cb9?auto=format&fit=crop&w=1200&q=80",
  ogType = "website",
} = Astro.props;

const rawPath = (currentPath || "/").split("?")[0].split("#")[0];
const normalizedPath = rawPath === "/" ? "/" : `${rawPath.replace(/\/+$/, "")}/`;
const pathSegments = normalizedPath.replace(/^\/+|\/+$/g, '').split('/');
const detectedLang = allLanguages.includes(pathSegments[0] as SupportedLanguage)
  ? (pathSegments[0] as SupportedLanguage)
  : (lang || defaultLang);

const currentLang: SupportedLanguage = detectedLang;
const langMeta = languages[currentLang] || languages[defaultLang];
const cleanPath = getPathWithoutLang(normalizedPath);
const canonicalUrl = `https://lankawayfinder.tours${normalizedPath}`;
const markdownPath = normalizedPath === "/" ? "/index.md" : `${normalizedPath.replace(/\/+$/, "")}.md`;
const markdownUrl = `https://lankawayfinder.tours${markdownPath}`;
---

<!doctype html>
<html lang={langMeta.code}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="ai-summary" content={description} />
    <meta name="google-site-verification" content="HgYszjZCVL6jre3cyqc7fNsKAkmcdBaG80uoFp_r1IM" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownUrl} title={`${title} (Markdown)`} />}

    <!-- Multilingual Alternates (hreflang) for Google & Bing -->
    {!noindex && (
      <>
        <link rel="alternate" hreflang="en" href={`https://lankawayfinder.tours${cleanPath}`} />
        <link rel="alternate" hreflang="de" href={`https://lankawayfinder.tours/de${cleanPath}`} />
        <link rel="alternate" hreflang="fr" href={`https://lankawayfinder.tours/fr${cleanPath}`} />
        <link rel="alternate" hreflang="ru" href={`https://lankawayfinder.tours/ru${cleanPath}`} />
        <link rel="alternate" hreflang="it" href={`https://lankawayfinder.tours/it${cleanPath}`} />
        <link rel="alternate" hreflang="es" href={`https://lankawayfinder.tours/es${cleanPath}`} />
        <link rel="alternate" hreflang="x-default" href={`https://lankawayfinder.tours${cleanPath}`} />
      </>
    )}

    <!-- Google Fonts: Playfair Display + Inter (matching giliair.com aesthetic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Social & OpenGraph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="LankaWayfinder" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={langMeta.ogLocale} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      }
    />
    <meta name="theme-color" content="#FDF9F2" />

    <!-- Organization & WebSite JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://lankawayfinder.tours/#website",
          "url": "https://lankawayfinder.tours/",
          "name": "LankaWayfinder",
          "alternateName": "LankaWayfinder.tours",
          "description": "Independent Sri Lanka Safaris, Chauffeur Transfers & Island Travel Guide",
          "inLanguage": "en-US",
          "publisher": {
            "@id": "https://lankawayfinder.tours/#organization"
          }
        },
        {
          "@type": ["Organization", "TravelAgency"],
          "@id": "https://lankawayfinder.tours/#organization",
          "name": "LankaWayfinder",
          "url": "https://lankawayfinder.tours/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://lankawayfinder.tours/favicon.svg"
          },
          "description": "Independent route intelligence, verified 4x4 safari jeeps, and private transfer logistics across Sri Lanka. Curated by licensed transport dispatchers.",
          "sameAs": [
            "https://www.lankawayfinder.com"
          ],
          "areaServed": {
            "@type": "Country",
            "name": "Sri Lanka",
            "sameAs": "https://en.wikipedia.org/wiki/Sri_Lanka"
          },
          "knowsAbout": [
            "Yala National Park Block 1 Leopard Safaris",
            "Udawalawe National Park Wild Elephant Safaris",
            "Minneriya National Park Elephant Gathering",
            "Department of Wildlife Conservation (DWC) Sri Lanka Entrance Permits",
            "Kandy to Ella Scenic Train Reserved Observation Tickets",
            "Colombo Bandaranaike International Airport (CMB) Private Chauffeur Transfers",
            "Sigiriya Lion Rock Citadel & Cultural Triangle Logistics",
            "Mirissa Blue Whale Watching & Galle Dutch Fort"
          ],
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "contactType": "customer support",
              "telephone": "+1-855-957-1272",
              "url": "https://lankawayfinder.tours/contact/",
              "availableLanguage": ["English"]
            },
            {
              "@type": "ContactPoint",
              "contactType": "reservations",
              "telephone": "+49-151-23457858",
              "url": "https://wa.me/4915123457858",
              "availableLanguage": ["English"]
            }
          ],
          "publishingPrinciples": "https://lankawayfinder.tours/affiliate-disclosure/"
        }
      ]
    })} />

    <!-- Official GetYourGuide Partner Widget Script -->
    <script async defer src="https://widget.getyourguide.com/dist/pa.umd.production.min.js"></script>

    <!-- PostHog Analytics, Heatmaps & Session Replay -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_wj88tJxb7Yg3sLqSaCrjAjxJSiSyvGqt8oBpG6uRaUL8', {
        api_host: 'https://us.i.posthog.com',
        person_profiles: 'identified_only',
        capture_pageview: true,
        capture_pageleave: true,
        autocapture: true
      });

      // Track GetYourGuide affiliate & WhatsApp lead conversions
      if (typeof window !== 'undefined') {
        document.addEventListener('click', function(e) {
          var target = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!target || !target.href) return;
          var href = target.href;
          if (href.indexOf('getyourguide.com') !== -1) {
            posthog.capture('affiliate_click', {
              partner: 'getyourguide',
              url: href,
              anchor_text: target.innerText ? target.innerText.trim().slice(0, 100) : '',
              page: window.location.pathname
            });
          } else if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
            posthog.capture('lead_click', {
              channel: 'whatsapp',
              url: href,
              page: window.location.pathname
            });
          }
        });
      }
    </script>
  </head>
  <body id="top">
    <!-- Skip to content for accessibility -->
    <a href="#main" class="sr-only focus:not-sr-only focus:p-4 focus:bg-white focus:text-[#16252B] focus:absolute focus:z-50 focus:rounded">
      Skip to content
    </a>

    <!-- Sticky Navigation Bar (Matching user reference header) -->
    <Navigation currentPath={normalizedPath} currentLang={currentLang} />

    <!-- Main Page Content -->
    <main id="main">
      <slot />
    </main>

    <!-- Site Footer -->
    <Footer currentLang={currentLang} />

    <!-- Ambient Spotlight Hover Engine for Tour Cards & Interactive Modules -->
    <script>
      function initSpotlight() {
        if (typeof window === "undefined" || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.addEventListener(
          "pointermove",
          (e) => {
            const card = (e.target as HTMLElement)?.closest?.(
              ".tour-card, .safari-calc, .driver-calc, .guide-card, .corridor-bento-card"
            ) as HTMLElement | null;
            if (!card) return;
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            card.style.setProperty("--spotlight-x", `${x}px`);
            card.style.setProperty("--spotlight-y", `${y}px`);
          },
          { passive: true }
        );
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSpotlight);
      } else {
        initSpotlight();
      }
    </script>
  </body>
</html>
